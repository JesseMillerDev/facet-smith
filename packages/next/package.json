{
  "name": "@facet-smith/next",
  "version": "0.1.0",
  "description": "Next.js App Router integration for FacetSmith",
  "license": "MIT",
  "author": "Jesse Miller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JesseMillerDev/facet-smith.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/JesseMillerDev/facet-smith#readme",
  "bugs": {
    "url": "https://github.com/JesseMillerDev/facet-smith/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.tsx src/client.tsx --format esm --dts --clean --external react --external next",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@facet-smith/core": "workspace:*",
    "@facet-smith/react": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "next": "16.3.1",
    "react": "19.2.8"
  },
  "publishConfig": {
    "access": "public"
  }
}

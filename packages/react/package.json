{
  "name": "@facet-smith/react",
  "version": "0.2.1",
  "description": "Typed React experimentation runtime for FacetSmith",
  "license": "MIT",
  "author": "Jesse Miller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JesseMillerDev/facet-smith.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/JesseMillerDev/facet-smith#readme",
  "bugs": {
    "url": "https://github.com/JesseMillerDev/facet-smith/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./markers": {
      "types": "./dist/markers.d.ts",
      "import": "./dist/markers.js",
      "require": "./dist/markers.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react && tsup --config tsup.markers.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@facet-smith/analytics": "workspace:*",
    "@facet-smith/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0"
  },
  "devDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "publishConfig": {
    "access": "public"
  }
}

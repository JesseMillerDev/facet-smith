{
  "name": "facetsmith-workspace",
  "version": "0.1.0",
  "description": "Source-native A/B/N experimentation for React and Next.js",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Jesse Miller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JesseMillerDev/facet-smith.git"
  },
  "homepage": "https://github.com/JesseMillerDev/facet-smith#readme",
  "bugs": {
    "url": "https://github.com/JesseMillerDev/facet-smith/issues"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "dev": "corepack pnpm -r --filter @facet-smith/next-app^... --if-present build && corepack pnpm --filter @facet-smith/next-app dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "integrity:check": "corepack pnpm --filter @facet-smith/cli build && node packages/cli/dist/cli.js check --cwd . && node packages/cli/dist/cli.js manifest --cwd . --check facetsmith.manifest.json",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "release:check": "corepack pnpm build && node scripts/release-check.mjs",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "playwright": "playwright",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version",
    "release:publish": "corepack pnpm release:check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "27.4.0",
    "prettier": "3.7.4",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
